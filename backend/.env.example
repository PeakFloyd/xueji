# Server listens on loopback by default. Set HOST only behind trusted authentication/reverse proxy.
HOST=127.0.0.1
PORT=8090
CORS_ORIGIN=http://localhost:3000
# Use a provider/model from the pi-ai built-in catalog; configure its provider credentials in the server process.
PI_PROVIDER=openai
PI_MODEL=gpt-4o-mini
# Python interpreter used to run ai/tool_bridge.py (defaults to python).
PYTHON=python
# Session idle time; pending write confirmations always expire after 300 seconds.
SESSION_TTL_MS=1800000
